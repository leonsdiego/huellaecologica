<script type="text/javascript" src="https://www.google.com/jsapi"></script>
    <script type="text/javascript">
      google.load("visualization", "1", {packages:["corechart"]});
      google.setOnLoadCallback(drawChart);

      // Chart data/options and the chart instance are kept at outer scope so the
      // resize handler below can redraw with the same data instead of only sizing
      // the container: #chart_div's height changes at CSS breakpoints (see
      // .chartResponsive in styles.css), but Google Charts only fits itself to the
      // container at draw() time, so without a redraw the chart stays frozen at
      // whatever size it had on first paint.
      var footprintChartData, footprintChartOptions, footprintChart;

      function drawChart() {
        footprintChartData = google.visualization.arrayToDataTable([
          ['Grupo', 'Huella ecológica'],
		  <?php
		$resultadosGrupo = $this->resultadosGrupos;
		 foreach( $this->grupos as $grupo )
		 {
			echo "['". $grupo['nombre_grupo'] ."', ". $resultadosGrupo[$grupo['nombre_grupo']] . "],";
		 }
		?>]);

        footprintChartOptions = {
          title: 'Tu Huella Ecológica por categorías',
          is3D: true
        };

        footprintChart = new google.visualization.PieChart(document.getElementById('chart_div'));
        footprintChart.draw(footprintChartData, footprintChartOptions);

        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () {
            if (footprintChart) {
              footprintChart.draw(footprintChartData, footprintChartOptions);
            }
          }, 150);
        });
      }
    </script>

